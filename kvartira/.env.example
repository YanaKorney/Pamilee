# ═══════════════════════════════════════════════════════════════════
#  НАСТРОЙКИ ПРОГРАММЫ «МОЯ КВАРТИРА»
#
#  Как пользоваться этим файлом:
#    1. Скопируйте его и назовите копию просто  .env  (без .example)
#    2. Откройте копию Блокнотом (Windows) или TextEdit (Mac)
#    3. Впишите ключи после знака =
#    4. Сохраните и перезапустите программу
#
#  Без ключей программа тоже работает: можно создавать проекты,
#  строить 3D и ходить по квартире. Не будут работать только
#  «Разобрать план» и «Создать визуализацию».
# ═══════════════════════════════════════════════════════════════════


# ─── 1. ЧТЕНИЕ ЧЕРТЕЖА ─────────────────────────────────────────────
# Этим сервисом программа читает ваш PDF и находит комнаты и мебель.

PLAN_API_KEY=
PLAN_BASE_URL=https://api.aitunnel.ru/v1
PLAN_MODEL=claude-opus-5

#  Адрес выше — для AITunnel. Если пользуетесь другим сервисом,
#  возьмите адрес из его документации.
#
#  Название модели вручную подбирать не надо: откройте в программе
#  «Настройки» и выберите её из списка — программа сама спросит
#  каталог у сервиса.


# ─── 2. СОЗДАНИЕ ВИЗУАЛИЗАЦИЙ ──────────────────────────────────────
# Этим сервисом программа превращает кадр из 3D в фотографию.

IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.aitunnel.ru/v1
IMAGE_MODEL=flux.2-pro

#  Если сервис тот же, что и выше, — ключ здесь такой же.
#
#  Важно: модель должна принимать КАРТИНКУ НА ВХОД, а не только
#  текст. В каталоге AITunnel у таких моделей значки «T + картинка
#  → картинка» — например, вся линейка FLUX.2.


# ─── 3. ЗАЩИТА ОТ ЛИШНИХ ТРАТ ──────────────────────────────────────
# Сколько долларов в день программа может потратить на AI.
# Дойдёт до лимита — остановится и спросит вас.

DAILY_LIMIT_USD=3


# ─── 4. РАЗМЕРЫ ПО УМОЛЧАНИЮ (в миллиметрах) ───────────────────────
# Подставляются, когда точное значение неизвестно.
# Высота потолка в вашей квартире — 2900 мм.

CEILING_HEIGHT_MM=2900
OUTER_WALL_MM=250
INNER_WALL_MM=120
WINDOW_SILL_MM=800
WINDOW_TOP_MM=2300
DOOR_HEIGHT_MM=2100


# ─── 5. АДРЕС ПРОГРАММЫ ────────────────────────────────────────────
# Менять не нужно. Если порт 8000 занят, программа сама возьмёт
# следующий свободный и напишет об этом при запуске.

APP_PORT=8000
