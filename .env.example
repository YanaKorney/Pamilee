# ── Доступ к API Wildberries ─────────────────────────────────────────────
# Кабинет WB → Настройки → Доступ к API → Создать новый токен
#
# Нужны ДВЕ категории:
#   «Продвижение» — кампании, статистика рекламы, баланс (без неё не работает)
#   «Статистика»  — заказы кабинета, нужны для общего ДРР
# Другие категории не отмечайте: узкий доступ безопаснее.
# Режим «Только на чтение» — ставьте; сервис ничего не меняет в кабинете.
#
# Скопируйте этот файл в .env и вставьте свой токен. Файл .env в git не попадает.
# Проверить, что токен рабочий: python3 run.py check
WB_API_TOKEN=

# ── Пороги аналитики (можно менять на ходу) ──────────────────────────────
# Целевой ДРР, % — доля рекламных расходов в выручке с рекламы.
# Выше цели → предупреждение, выше цели×1.5 → критично.
WBADS_TARGET_DRR=15

# Минимальный расход за период, ниже которого кампанию не разбираем (руб.)
WBADS_MIN_SPEND=300

# Расход без единого заказа, после которого бьём тревогу (руб.)
WBADS_SPEND_NO_ORDERS=1500

# Какую цену заказа считать выручкой в общем ДРР:
#   price_with_disc — после вашей скидки (по умолчанию, как в рекламном отчёте)
#   finished_price  — что заплатил покупатель, с учётом СПП
#   total_price     — до скидок
WBADS_ORDER_PRICE=price_with_disc

# Порт локального дашборда
WBADS_PORT=8000

# Файл базы данных
WBADS_DB=data/wbads.db
