# Скопируйте этот файл в .env и впишите свои значения. Файл .env никому не показывайте.

# Поддомен вашей amoCRM: если адрес mycompany.amocrm.ru, то пишем mycompany
AMO_SUBDOMAIN=mycompany
# Долгосрочный токен из amoCRM (Настройки - Интеграции - ваша интеграция - Ключи и доступы)
AMO_TOKEN=
# Номер этапа «Монтаж» (необязательно; если пусто, бот реагирует на любой этап, где стоит вебхук)
AMO_MONTAGE_STATUS_ID=

# Названия полей в сделке (как они называются в amoCRM)
AMO_ADDRESS_FIELD=Адрес
AMO_DATE_FIELD=Дата монтажа
AMO_COMMENT_FIELD=Комментарий

# Токен бота из Max
MAX_TOKEN=
# Адрес API Max (менять только если в документации Max указан другой)
MAX_API_URL=https://platform-api.max.ru
# Max-ID руководителя: ему придёт сообщение, если монтажник не найден (необязательно)
MANAGER_MAX_USER_ID=

# Придумайте длинный случайный пароль из букв и цифр: он защищает адреса бота от посторонних
WEBHOOK_SECRET=
