# Автозапуск бота на сервере. Инструкция в README.md, шаг 6.
[Unit]
Description=Montage notification bot
After=network.target

[Service]
WorkingDirectory=/opt/montage-bot
ExecStart=/opt/montage-bot/venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
